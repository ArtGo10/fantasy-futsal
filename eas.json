{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "RCT_USE_PREBUILT_RNCORE": "0"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "development"
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "RCT_USE_PREBUILT_RNCORE": "0"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "RCT_USE_PREBUILT_RNCORE": "0"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_USE_PRECOMPILED_MODULES": "0",
        "RCT_USE_PREBUILT_RNCORE": "0"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
